{
  "name": "@nuskin/mfe-contentstack",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Contentstack delivery client, live preview, and getContent for Nu Skin MFEs",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:package": "tsup",
    "types:check": "tsc --pretty --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@contentstack/delivery-sdk": "^4.10.0",
    "@contentstack/live-preview-utils": "^4.1.0",
    "@contentstack/utils": "1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-typescript": "^7.23.2",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tsup": "^8.3.6",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
