{
  "name": "@nuskin/mfe-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Example MFEs — @nuskin/gateway-mfe SSR + client federation (local dev server)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "yarn build:lib && yarn build:client",
    "build:lib": "tsc -p tsconfig.json",
    "build:client": "webpack --config webpack.client.js --mode development",
    "dev": "yarn build && node --import tsx dev-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nuskin/gateway-mfe": "0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@module-federation/enhanced": "^0.15.0",
    "babel-loader": "^9.2.1",
    "typescript": "^5.7.3",
    "webpack": "5.88.0",
    "webpack-cli": "5.1.4"
  }
}
