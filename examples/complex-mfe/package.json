{
  "name": "@nuskin/example-mfe-complex",
  "version": "0.1.0",
  "private": true,
  "description": "Complex demo MFE — heavy client state, SEO, SSR + CSR",
  "scripts": {
    "build": "yarn build:client && yarn build:server",
    "build:client": "webpack --config webpack.client.js --mode development",
    "build:server": "webpack --config webpack.server.js --mode development",
    "start": "node server.js",
    "dev": "yarn build && node server.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@module-federation/enhanced": "^0.15.0",
    "@module-federation/node": "^2.7.7",
    "babel-loader": "^9.2.1",
    "express": "^4.21.2",
    "webpack": "5.88.0",
    "webpack-cli": "5.1.4"
  }
}
